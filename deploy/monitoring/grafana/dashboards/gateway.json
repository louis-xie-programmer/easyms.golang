{
  "annotations": {
    "list": [
      {
        "builtIn": 1,
        "datasource": "-- Grafana --",
        "enable": true,
        "hide": true,
        "iconColor": "rgba(0, 211, 255, 1)",
        "name": "Annotations & Alerts",
        "type": "dashboard"
      }
    ]
  },
  "editable": true,
  "gnetId": null,
  "graphTooltip": 0,
  "id": null,
  "links": [],
  "panels": [
    {
      "datasource": "Prometheus",
      "fieldConfig": {
        "defaults": {
          "unit": "reqps"
        },
        "overrides": []
      },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 0 },
      "id": 1,
      "targets": [
        {
          "expr": "sum(rate(gateway_requests_total{service=~\"$service\",route=~\"$route\"}[5m])) by (service, route)",
          "legendFormat": "{{service}} {{route}}",
          "refId": "A"
        }
      ],
      "title": "Request Rate",
      "type": "timeseries"
    },
    {
      "datasource": "Prometheus",
      "fieldConfig": {
        "defaults": {
          "unit": "percent"
        },
        "overrides": []
      },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 0 },
      "id": 2,
      "targets": [
        {
          "expr": "100 * sum(rate(gateway_requests_total{status=~\"5..\",service=~\"$service\",route=~\"$route\"}[5m])) / sum(rate(gateway_requests_total{service=~\"$service\",route=~\"$route\"}[5m]))",
          "legendFormat": "error %",
          "refId": "A"
        }
      ],
      "title": "5xx Error Rate",
      "type": "timeseries"
    },
    {
      "datasource": "Prometheus",
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 8 },
      "id": 3,
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum(rate(gateway_request_duration_seconds_bucket{service=~\"$service\",route=~\"$route\"}[5m])) by (le, service, route))",
          "legendFormat": "{{service}} {{route}}",
          "refId": "A"
        }
      ],
      "title": "Latency p95",
      "type": "timeseries"
    },
    {
      "datasource": "Prometheus",
      "fieldConfig": {
        "defaults": {
          "unit": "ops"
        },
        "overrides": []
      },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 8 },
      "id": 4,
      "targets": [
        {
          "expr": "sum(rate(gateway_upstream_retries_total{service=~\"$service\",route=~\"$route\"}[5m])) by (service, route, reason)",
          "legendFormat": "{{service}} {{route}} {{reason}}",
          "refId": "A"
        }
      ],
      "title": "Upstream Retries",
      "type": "timeseries"
    },
    {
      "datasource": "Prometheus",
      "fieldConfig": {
        "defaults": {
          "unit": "ops"
        },
        "overrides": []
      },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 16 },
      "id": 5,
      "targets": [
        {
          "expr": "sum(rate(gateway_ratelimit_blocked_total[5m])) by (rule)",
          "legendFormat": "{{rule}}",
          "refId": "A"
        }
      ],
      "title": "Rate Limit Blocked",
      "type": "timeseries"
    },
    {
      "datasource": "Prometheus",
      "fieldConfig": {
        "defaults": {
          "unit": "ops"
        },
        "overrides": []
      },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 16 },
      "id": 6,
      "targets": [
        {
          "expr": "rate(gateway_ratelimit_redis_errors_total[5m])",
          "legendFormat": "redis errors",
          "refId": "A"
        }
      ],
      "title": "Rate Limit Redis Errors",
      "type": "timeseries"
    },
    {
      "datasource": "Prometheus",
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 24 },
      "id": 7,
      "targets": [
        {
          "expr": "max(gateway_circuitbreaker_state{state=\"open\",service=~\"$service\"}) by (service)",
          "legendFormat": "{{service}}",
          "refId": "A"
        }
      ],
      "title": "Circuit Breaker Open",
      "type": "timeseries"
    }
  ],
  "refresh": "10s",
  "schemaVersion": 38,
  "style": "dark",
  "tags": ["gateway"],
  "templating": {
    "list": [
      {
        "current": { "text": ".*", "value": ".*" },
        "datasource": "Prometheus",
        "definition": "label_values(gateway_requests_total, service)",
        "hide": 0,
        "name": "service",
        "options": [],
        "query": "label_values(gateway_requests_total, service)",
        "refresh": 1,
        "type": "query"
      },
      {
        "current": { "text": ".*", "value": ".*" },
        "datasource": "Prometheus",
        "definition": "label_values(gateway_requests_total, route)",
        "hide": 0,
        "name": "route",
        "options": [],
        "query": "label_values(gateway_requests_total, route)",
        "refresh": 1,
        "type": "query"
      }
    ]
  },
  "time": { "from": "now-1h", "to": "now" },
  "timepicker": {},
  "timezone": "",
  "title": "Gateway",
  "version": 1
}
